# Arc testnet (public defaults — override ARC_RPC_URL if you use a private RPC)
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_WSS_URL=
ARC_CHAIN_ID=5042002
ARC_EXPLORER_API_URL=https://testnet.arcscan.app/api
ARC_EXPLORER_API_KEY=

# Ethereum Sepolia (Gateway source chain)
ETH_RPC_URL=
ETH_CHAIN_ID=11155111

# Deployer / wallets — never commit real keys
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
LENDER_PRIVATE_KEY=
LENDER_ADDRESS=
BORROWER_PRIVATE_KEY=
BORROWER_ADDRESS=
SOLVER_PRIVATE_KEY=
SOLVER_ADDRESS=

# Contract addresses (filled in after DeployCore — also see contracts/deployments/<chainId>.json)
INTENT_SETTLEMENT_ADDRESS=
LOAN_MANAGER_ADDRESS=
FEE_MANAGER_ADDRESS=
PRICE_ORACLE_ADDRESS=
ETH_USD_FEED_ADAPTER_ADDRESS=
USDC_ARC_ADDRESS=0x3600000000000000000000000000000000000000
WETH_ARC_ADDRESS=
WETH_ADDRESS=
# Sepolia USDC (Circle faucet / docs): https://developers.circle.com/gateway/quickstarts/unified-balance-evm
USDC_ETH_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Arc predeployed utils (do not redeploy)
CREATE2_FACTORY=0x4e59b44847b379578588920cA78FbF26c0B4956C
MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# Chainlink Arc ETH/USD proxy (from Chainlink RDD — not Circle docs).
# On Arc testnet this address currently has no code; scripts fall back to a mock.
ETH_USD_FEED=0x50FCDD99D6762D1C170DC6A9111db944AEE6D364
SKIP_ETH_USD_FEED_ADAPTER=false
USE_MOCK_USDC=false
# 5 USDC default — Circle Arc faucet is ~20 USDC; same wallet needs principal+fees+gas.
FILL_AMOUNT=5000000
# Collateral for match (wei). Required for a real match — compute from oracle LTV.
COLLATERAL_AMOUNT=

# ─── Circle Gateway (from developers.circle.com/gateway — not placeholders) ───
# Testnet API: https://gateway-api-testnet.circle.com
# Mainnet API: https://gateway-api.circle.com
GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# Domain IDs: https://developers.circle.com/gateway/references/supported-blockchains
# Ethereum Sepolia = 0, Arc = 26
GATEWAY_DOMAIN_ETH=0
GATEWAY_DOMAIN_ARC=26
# Vanity addresses (same on all EVM testnets per Circle how-to)
GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
GATEWAY_MINTER_ADDRESS=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
# Optional override (USDC 6 decimals). Prefer /v1/estimate. Eth source gas alone ≈ 1 USDC.
GATEWAY_MAX_FEE=

# Solver daemon
SOLVER_PORT=8787
